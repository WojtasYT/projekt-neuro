#!/bin/sh
# Gradle start-up. The wrapper JAR is generated by Android Studio
# or: gradle wrapper --gradle-version 8.13
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "Brak gradle-wrapper.jar."
  echo "Otwórz folder android/ w Android Studio (New → Open) — Studio pobierze wrapper,"
  echo "albo z zainstalowanym Gradle: (cd android && gradle wrapper --gradle-version 8.13)"
  exit 1
fi
exec java -jar "$JAR" "$@"
